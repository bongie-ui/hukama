# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: PostgreSQL (Render sets this automatically). Leave empty for SQLite.
DATABASE_URL=

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Where PayPal sends subscribers back after approving a premium (on Render this defaults to the service URL)
PUBLIC_BASE_URL=http://localhost:8000/
VITE_PAYPAL_CLIENT_ID=             # same sandbox client id, public
VITE_AG_STUDIO_LICENSE_KEY=        # AG Studio trial licence (public, baked into the build)

# Chat by phone (optional): a messaging provider's test number forwards messages to the assistant.
# Twilio console -> Messaging -> Try it out -> WhatsApp sandbox. Webhook "When a message comes in":
#   <PUBLIC_BASE_URL>api/channels/phone/  (POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PHONE_JOIN_CODE=                   # the sandbox's join words, e.g. "word-word" (shown on People)

# OpenAI (agent/llm.py)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FAST=

# HMAC key for mandate signatures. Required in production; any long random string.
MANDATE_SIGNING_KEY=
# Country code for normalising local phone numbers (0771234567 -> +263771234567)
DEFAULT_PHONE_COUNTRY_CODE=263

DEMO_MODE=true
DEMO_REPLAY=false
DEMO_PASSWORD=
DEMO_FUNDER_1_EMAIL=
DEMO_FUNDER_2_EMAIL=
DEMO_FUNDER_3_EMAIL=
# Sandbox accounts used by seed_demo. Optional: defaults are in core/management/commands/seed_demo.py
DEMO_PAYEE_HARDWARE_EMAIL=
DEMO_PAYEE_SCHOOL_EMAIL=
DEMO_PAYEE_MOBILE_MONEY_EMAIL=
DEMO_PAYEE_GROCER_EMAIL=
