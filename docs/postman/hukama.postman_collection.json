              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.json().csrf_token) pm.collectionVariables.set('csrfToken', pm.response.json().csrf_token);"
