                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const card = pm.response.json().messages.reverse().find(m => m.card)?.card;",
                  "pm.test('held for fraud', () => pm.expect(card.status).to.eql('HELD_FRAUD'));",
                  "pm.test('sender sees no fraud details', () => pm.expect(card.reason).to.be.undefined);",
                  "pm.collectionVariables.set('heldRequestId', card.request_id);"
                ]
              }
            }
